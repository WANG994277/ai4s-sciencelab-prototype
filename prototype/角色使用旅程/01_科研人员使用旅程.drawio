          <mxGeometry as="geometry" x="962.0" y="2195" width="46" height="30" />
        </mxCell>
        <mxCell id="edgeText18" value="是" vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#526782;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;spacing=0;">
          <mxGeometry as="geometry" x="727.0" y="2305" width="46" height="30" />
        </mxCell>
        <mxCell id="edgeText19" value="按需" vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#526782;fontStyle=0;fillColor=#FFFFFF;strokeColor=none;spacing=0;">
          <mxGeometry as="geometry" x="944.0" y="2400" width="52" height="30" />
        </mxCell>
        <mxCell id="title" value="ScienceLab AI4S  /  科研人员使用旅程" vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=30;fontColor=#0B2146;fontStyle=1;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry as="geometry" x="40" y="25" width="1440" height="53" />
        </mxCell>
        <mxCell id="subtitle" value="核心入口：科研超级中枢｜提交问题与材料 → 确认计划 → 中枢组织读、算 → 人工复核与迭代" vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#526782;fontStyle=0;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry as="geometry" x="40" y="91" width="1440" height="52" />
        </mxCell>
        <mxCell id="note0" value="起点：已有研究目标或待解决问题。&#10;课题空间提供研究归属；&#10;读、算操作围绕科研超级中枢展开。" vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#526782;fontStyle=0;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry as="geometry" x="95" y="355" width="380" height="90" />
        </mxCell>
        <mxCell id="note1" value="中枢可以调用底层知识、模型与工具。&#10;科研人员通过中枢推进任务，&#10;本旅程不要求其进入 AI 中台开发工具。&#10;底层服务接入状态以实际环境为准。" vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#526782;fontStyle=0;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry as="geometry" x="1100" y="550" width="315" height="145" />
        </mxCell>
        <mxCell id="note2" value="读、算按计划选择和组合，&#10;可以只读、只算或读算迭代。&#10;图中两支不要求同时执行，&#10;在产出节点汇集本次实际结果。" vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#526782;fontStyle=0;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry as="geometry" x="130" y="1190" width="315" height="130" />
        </mxCell>
        <mxCell id="note3" value="“依据充分”并不等于假设成立。&#10;反驳假设或保留分歧，也可以形成&#10;有来源、有边界的阶段判断。" vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#526782;fontStyle=0;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry as="geometry" x="95" y="2165" width="355" height="125" />
        </mxCell>
        <mxCell id="note4" value="图例：实框＝原型现有或本地演示；虚框＝尚待接入或未核实的业务环节。&#10;实箭头＝正常推进；虚箭头＝退回、跨角色交接或可选路径。" vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#0B2146;fontStyle=1;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry as="geometry" x="40" y="2610" width="1440" height="65" />
        </mxCell>
        <mxCell id="note5" value="交付：阶段判断、证据与产物、下一轮研究问题或待评审材料。&#10;当前读、算运行仍为演示；权限申请、异常重试与成果送审的具体联动需在目标环境核实。" vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#526782;fontStyle=0;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry as="geometry" x="40" y="2695" width="1440" height="80" />
        </mxCell>
        <mxCell id="date" value="角色与系统分工依据用户确认；对应原型模块参考本工作区。更新：2026-10-10" vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#526782;fontStyle=0;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry as="geometry" x="40" y="2790" width="1440" height="22" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>