        <mxCell id="title" value="ScienceLab AI4S  /  科研项目管理人员使用旅程" vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=30;fontColor=#0B2146;fontStyle=1;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry as="geometry" x="40" y="25" width="1440" height="53" />
        </mxCell>
        <mxCell id="subtitle" value="管理主线：定位项目 → 明确阶段要求 → 跟踪风险 → 核查材料与组织评审 → 跟进整改或确认交付" vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#526782;fontStyle=0;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry as="geometry" x="40" y="91" width="1440" height="52" />
        </mxCell>
        <mxCell id="note0" value="管理人员围绕项目和阶段决策。&#10;科研超级中枢的读、算结果&#10;是核查材料的一部分，&#10;不能用任务完成数替代&#10;科研进展与交付依据。" vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#526782;fontStyle=0;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry as="geometry" x="90" y="450" width="340" height="155" />
        </mxCell>
        <mxCell id="note1" value="科研人员提交：报告、证据、验证计划。&#10;工具创建人员提交：能力版本、&#10;测试依据、适用边界与维护说明。&#10;当前管理页到课题可能需手动转场。" vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#526782;fontStyle=0;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry as="geometry" x="90" y="1080" width="340" height="150" />
        </mxCell>
        <mxCell id="note2" value="管理反馈必须对应具体问题：&#10;谁来处理、补什么材料，&#10;以及下一次如何判定完成。" vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#526782;fontStyle=0;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry as="geometry" x="1100" y="1390" width="325" height="120" />
        </mxCell>
        <mxCell id="note3" value="专家判断科学证据是否充分；&#10;管理人员按授权确认项目交付。&#10;阶段验收通过不意味着&#10;所有科研假设都获得支持。" vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#0B2146;fontStyle=1;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry as="geometry" x="90" y="1660" width="340" height="150" />
        </mxCell>
        <mxCell id="note4" value="配套管理：外协、人才、考核与日程。&#10;按项目需要参与本旅程，&#10;不要求每次都依次办理。" vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#526782;fontStyle=0;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry as="geometry" x="1100" y="2200" width="330" height="115" />
        </mxCell>
        <mxCell id="note5" value="图例：实框＝原型已有可查看页面；虚框＝管理业务要求，正式台账或流转尚待接入。&#10;实箭头＝正常推进；虚箭头＝跨角色交接、整改与下一阶段循环。" vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#0B2146;fontStyle=1;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry as="geometry" x="40" y="2460" width="1440" height="75" />
        </mxCell>
        <mxCell id="note6" value="交付：有依据的阶段决定、责任分工、复核条件、后续节点及最终归档材料。&#10;当前管理模块和管理智能体多为入口提示；本图不代表真实审批、会签、通知、验收或权限控制已经完成。" vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#526782;fontStyle=0;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry as="geometry" x="40" y="2560" width="1440" height="80" />
        </mxCell>
        <mxCell id="date" value="角色与系统分工依据用户确认；对应原型模块参考本工作区。更新：2026-10-10" vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#526782;fontStyle=0;fillColor=none;strokeColor=none;spacing=0;">
          <mxGeometry as="geometry" x="40" y="2640" width="1440" height="22" />
