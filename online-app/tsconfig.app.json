{
  "extends": "@lark-apaas/coding-presets-react/lib/tsconfig/tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@shared/*": [
        "./shared/*"
      ],
      "next/navigation": [
        "./src/compat/navigation.ts"
      ],
      "next/link": [
        "./src/compat/link.tsx"
      ]
    }
  },
  "include": [
    "src/index.tsx",
    "src/env.d.ts"
  ]
}